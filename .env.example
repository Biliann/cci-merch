# Configure production secrets in the hosting dashboard; locally use .dev.vars.
# Without RESEND_API_KEY, emails are persisted as previews, no delivery is claimed.
RESEND_API_KEY=
EMAIL_FROM=CCI Merchandise <orders@your-verified-domain.com>
APP_URL=http://localhost:5173
EMAIL_PREVIEW=true
DEMO_MODE=true
# Replace demo supplier addresses before using real email.
SUPPLIER_SOUTH_EMAIL=south@example.com
SUPPLIER_NORTH_EMAIL=north@example.com
SUPPLIER_WEST_EMAIL=west@example.com
SUPPLIER_EAST_EMAIL=east@example.com
